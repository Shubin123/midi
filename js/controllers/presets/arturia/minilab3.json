{
 "$schema": "../../schema.json",
 "format": 1,
 "id": "arturia/minilab3",
 "name": "Arturia MiniLab 3",
 "maker": "Arturia",
 "models": ["MiniLab 3"],
 "firmware": { "min": "1.0.5", "notes": "Messages from the manual v1.0.5 (Oct 2022) and Arturia's MIDI implementation chart. Relative encoders exist in User programs from firmware 1.1 (MCC: Relative 1 = binary offset, Relative 2 = two's complement; Relative 3 isn't documented). Firmware 1.2.0 (Dec 2024) changed what the screen shows for automated controls, not the messages." },
 "author": "midi (Shubin123/midi)",
 "version": "1.0.0",
 "licence": "MIT",
 "status": "official",
 "verified": "documented",
 "description": "25 velocity keys, pitch and mod touch strips, 8 encoders, 4 faders, 8 RGB pads in two banks with poly pressure, a clickable main encoder, Shift, Hold, Octave and a two-line screen. Every message is from Arturia's documentation or Arturia's and DAW makers' own integration scripts (listed in sources); none has been checked against captures from a real unit yet, so it is marked documented, not hardware.",
 "sources": [
  { "id": "manual", "title": "MiniLab 3 user manual v1.0.5 (17 Oct 2022)", "url": "https://downloads.arturia.com/products/minilab-3/manual/minilab-3_Manual_1_0_5_EN.pdf" },
  { "id": "cheatsheet", "title": "MiniLab 3 cheat sheet", "url": "https://dl.arturia.net/products/minilab-3/manual/minilab-3_Manual_1_0_0-cheatsheet_EN.pdf" },
  { "id": "chart", "title": "Arturia support: MiniLab 3 General Questions (ports, MIDI implementation chart)", "url": "https://support.arturia.com/hc/en-us/articles/6189475866396" },
  { "id": "daw-kb", "title": "Arturia support: MiniLab 3 DAW Integration", "url": "https://support.arturia.com/hc/en-us/articles/6283884020508" },
  { "id": "bitwig", "title": "Bitwig extension for MiniLab 3 (commit 3379f3d)", "url": "https://github.com/bitwig/bitwig-extensions/tree/3379f3d4404930c34040d3e8c6b28fdfb766a7d3/src/main/java/com/bitwig/extensions/controllers/arturia/minilab3" },
  { "id": "ableton", "title": "Ableton Live 12 MiniLab_3 remote script (decompiled)", "url": "https://github.com/gluon/AbletonLive12_MIDIRemoteScripts/tree/0336151d3ad8c9c8213ae327d51f8e9381cd18aa/MiniLab_3" },
  { "id": "arturia-scripts", "title": "Arturia's FL Studio, Logic, Reason and Cubase integration scripts for MiniLab 3", "url": "https://downloads.arturia.com/products/minilab-3/daw-integration-script/" },
  { "id": "forum-relative", "title": "Arturia forum: MiniLab mk3 relative mode (Arturia QA, 2023-08-31)", "url": "https://forum.arturia.com/t/minilab-mk3-relative-mode-ableton-still-not-working/1270", "notes": "Community forum, an Arturia staff answer." },
  { "id": "sos-fw11", "title": "Sound On Sound: Arturia update MiniLab 3 firmware (1.1)", "url": "https://www.soundonsound.com/news/arturia-update-minilab-3-firmware" }
 ],
 "detect": {
  "identity": { "manufacturer": "00 20 6B", "family": "02 00", "member": "04 04", "source": "Identity reply F0 7E 7F 06 02 00 20 6B 02 00 04 04 vv vv vv vv F7: Reason codec MiniLab3.lua, FL device_MiniLab3.py (supportedHardwareIds), Cubase script, Ableton __init__.py" },
  "ports": [
   { "name": "^(\\d+- )?(minilab3 )?minilab3( midi)?$", "role": "main", "source": "\"Minilab3 MIDI\" (macOS), \"Minilab3\" or \"2- Minilab3 MIDI\" (Windows), \"Minilab3 Minilab3 MIDI\" (Linux): Bitwig MiniLab3ExtensionDefinition.java; Logic config.lua. The manual's \"MiniLab 3 MIDI\" (with a space) appears in prose only." },
   { "name": "^(\\d+- )?(minilab3 )?minilab3 (mcu|hui|mcu/hui)", "role": "daw", "source": "manual §5.2 (4 ports); chart article: \"MCU/HUI\" port, which \"will trigger notes when pressing the transport pads\" in Mackie/HUI mode, so its notes are kept from playing" },
   { "name": "^(\\d+- )?(minilab3 )?minilab3 alv", "role": "ignore", "source": "manual §5.2: the ALV port is for Analog Lab" }
  ]
 },
 "listen": [
  { "message": ["F0", "00", "20", "6B", "7F", "42", "02", "00", "40", "62", "{value}", "F7"], "means": "program", "values": { "1": "arturia", "2": "daw" }, "otherwise": "user", "source": "Sent by the controller when a program loads: Bitwig MiniLab3Extension.java L194-203, FL, Ableton midi.py (PROGRAM_LOAD_BYTE 98: DAW is 2). The value for a User program isn't documented: anything else is taken as a User program." },
  { "message": ["F0", "00", "20", "6B", "7F", "42", "02", "00", "40", "01", "{value}", "F7"], "means": "program", "values": { "0": "arturia", "1": "daw" }, "otherwise": "user", "source": "Reply to the program request: Bitwig L204-216, Ableton midi.py (REQUEST_DATA_BYTE: DAW is 1)" },
  { "message": ["F0", "00", "20", "6B", "7F", "42", "02", "00", "40", "63", "{value}", "F7"], "means": "bank", "values": { "0": "A", "1": "B" }, "source": "Sent on a bank change and in reply to the bank request: Bitwig L97, L186-193" }
 ],
 "queries": [
  ["F0", "00", "20", "6B", "7F", "42", "01", "00", "40", "01", "F7"],
  ["F0", "00", "20", "6B", "7F", "42", "01", "00", "40", "03", "F7"]
 ],
