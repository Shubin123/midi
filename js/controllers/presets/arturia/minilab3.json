  "pads": {
   "message": ["F0", "00", "20", "6B", "7F", "42", "02", "02", "16", "{index}", "{r}", "{g}", "{b}", "F7"],
   "index": { "pad1": 52, "pad2": 53, "pad3": 54, "pad4": 55, "pad5": 56, "pad6": 57, "pad7": 58, "pad8": 59, "pad9": 68, "pad10": 69, "pad11": 70, "pad12": 71, "pad13": 72, "pad14": 73, "pad15": 74, "pad16": 75, "shift-pad1": 84, "shift-pad2": 85, "shift-pad3": 86, "loop": 87, "stop": 88, "play": 89, "record": 90, "tap": 91 },
   "scale": 127,
   "programs": ["daw"],
   "source": "One pad's colour, R G B 0-127, in the DAW program (patch byte 02): Bitwig MinilabRgbButton.java (\"DAW Preset\"), RgbLightState; pad ids bank A 0x34-0x3B, bank B 0x44-0x4B, Shift layer 0x54-0x5B: Bitwig PadBank.java, Ableton midi.py PAD_ID_TO_SYSEX_ID, FL, Reason. Logic's PAD_MATRIX uses 0x3C-0x43 for bank B instead; the three others agree on 0x44."
  },
  "screen": {
   "message": ["F0", "00", "20", "6B", "7F", "42", "04", "02", "60", "01", "{text:line1:10}", "00", "02", "{text:line2:18}", "00", "F7"],
   "lines": 2,
   "widths": [10, 18],
   "programs": ["daw"],
   "source": "Two lines of ASCII text in the DAW program: Bitwig OledDisplay.java (plain text), Ableton display_util.py (lines cut to 10 and 18 characters; FL and Logic send up to 31, so the physical limit isn't documented: 10 and 18 are what Ableton's script trusts)."
  },
  "encoders": {
   "message": ["F0", "00", "20", "6B", "7F", "42", "21", "10", "00", "{index}", "00", "{value}", "F7"],
   "index": { "knob1": 7, "knob2": 8, "knob3": 9, "knob4": 10, "knob5": 11, "knob6": 12, "knob7": 13, "knob8": 14 },
   "programs": ["daw"],
   "source": "Re-aligns an encoder's value (0-127) in the DAW program: Ableton encoder.py RealigningEncoderMixin and midi.py ENCODER_VALUE_HEADER (21 10 00), Cubase. FL sends 21 10 40 instead."
  }
