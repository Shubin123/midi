 "id": "generic/knobs",
 "name": "Generic 8-knob",
 "maker": "Generic",
 "models": [
  "Any controller with knobs"
 ],
 "status": "official",
 "verified": "unverified",
 "generic": true,
 "description": "Eight knobs, whatever they send: the first eight different CCs the controller sends become knobs 1 to 8, in the order you turn them (a relative encoder is told from a knob by its values), and they move the page's parameters. Keys, wheels and the pedal play as on a keyboard.",
 "sources": [
  {
   "id": "gm",
   "title": "MIDI 1.0 Detailed Specification and General MIDI 1 (MIDI Association)",
   "url": "https://midi.org/specs",
   "notes": "CC 1 modulation, CC 64 sustain, channel 10 percussion with notes 35-81, pitch bend centred at 8192."
  }
 ],
