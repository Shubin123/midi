{
 "$schema": "../../schema.json",
 "format": 1,
 "author": "midi (Shubin123/midi)",
 "version": "1.0.0",
 "licence": "MIT",
 "id": "generic/keyboard",
 "name": "Generic keyboard",
 "maker": "Generic",
 "models": [
  "Any MIDI keyboard"
 ],
 "status": "official",
 "verified": "documented",
 "generic": true,
 "description": "Any keyboard: keys with velocity, the pitch wheel, the mod wheel (vibrato, or a control: Settings in the Controllers widget), the sustain pedal and channel aftertouch (vibrato). The same as plain MIDI, as a preset to build on.",
 "sources": [
  {
   "id": "gm",
   "title": "MIDI 1.0 Detailed Specification and General MIDI 1 (MIDI Association)",
   "url": "https://midi.org/specs",
   "notes": "CC 1 modulation, CC 64 sustain, channel 10 percussion with notes 35-81, pitch bend centred at 8192."
  }
 ],
 "controls": [
  {
   "id": "keys",
   "type": "keys",
   "label": "Keys",
   "role": "keys",
   "velocity": true
  },
  {
   "id": "bend",
   "type": "wheel",
   "label": "Pitch wheel",
   "role": "pitch wheel"
  },
  {
   "id": "mod",
   "type": "wheel",
   "label": "Mod wheel",
   "role": "mod wheel"
  },
  {
   "id": "pedal",
   "type": "pedal",
   "label": "Sustain pedal",
   "role": "sustain pedal"
  },
  {
   "id": "pressure",
   "type": "keys",
   "label": "Aftertouch",
   "role": "aftertouch",
   "aftertouch": "channel"
  }
 ],
 "programs": [
  {
   "id": "any",
   "name": "Any",
   "default": true,
   "messages": {
    "keys": {
     "notes": [
      0,
      127
     ],
     "channel": "any",
     "source": "gm"
    },
    "bend": {
     "bend": true,
     "channel": "any"
    },
    "mod": {
     "cc": 1,
     "channel": "any",
     "encoding": "absolute"
    },
    "pedal": {
     "cc": 64,
     "channel": "any",
     "encoding": "absolute"
    },
    "pressure": {
     "pressure": true,
     "channel": "any"
    }
   }
  }
 ],
 "variations": [
  {
   "id": "keyboard",
   "name": "Keyboard",
   "default": true,
   "mappings": {
    "keys": {
     "do": "notes"
    },
    "bend": {
     "do": "bend"
    },
    "mod": {
     "do": "mod"
    },
    "pedal": {
     "do": "sustain"
    },
    "pressure": {
     "do": "pressure"
    }
   }
  }
 ]
}
