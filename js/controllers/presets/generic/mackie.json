 "detect": {
  "ports": [
   {
    "name": "\\b(mcu|mackie|hui)\\b",
    "role": "main",
    "source": "a port named for Mackie Control"
   }
  ]
 },
 "programs": [
  {
   "id": "mcu",
   "name": "Mackie Control",
   "default": true,
   "messages": {
    "vpot1": {
     "cc": 16,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot2": {
     "cc": 17,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot3": {
     "cc": 18,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot4": {
     "cc": 19,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot5": {
     "cc": 20,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot6": {
     "cc": 21,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot7": {
     "cc": 22,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "vpot8": {
     "cc": 23,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Pot::ID 0x10 + strip; bit 6 is the sign, bits 0-5 the ticks"
    },
    "fader1": {
     "bend": true,
     "channel": 1,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader2": {
     "bend": true,
     "channel": 2,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader3": {
     "bend": true,
     "channel": 3,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader4": {
     "bend": true,
     "channel": 4,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader5": {
     "bend": true,
     "channel": 5,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader6": {
     "bend": true,
     "channel": 6,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader7": {
     "bend": true,
     "channel": 7,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "fader8": {
     "bend": true,
     "channel": 8,
     "encoding": "absolute",
     "source": "ardour: one pitch bend channel per strip, 14 bits"
    },
    "master": {
     "bend": true,
     "channel": 9,
     "encoding": "absolute",
     "source": "ardour: the master fader on the channel after the strips"
    },
    "jog": {
     "cc": 60,
     "channel": "any",
     "encoding": "signed-bit",
     "source": "ardour: Jog::ID 0x3c"
    },
    "select1": {
     "note": 24,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select2": {
     "note": 25,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select3": {
     "note": 26,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select4": {
     "note": 27,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select5": {
     "note": 28,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select6": {
     "note": 29,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select7": {
     "note": 30,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "select8": {
     "note": 31,
     "channel": "any",
     "source": "ardour: Select 0x18 + strip"
    },
    "rewind": {
     "note": 91,
     "channel": "any",
     "source": "ardour: 0x5b"
    },
    "ffwd": {
     "note": 92,
     "channel": "any",
     "source": "ardour: 0x5c"
    },
    "stop": {
     "note": 93,
     "channel": "any",
     "source": "ardour: 0x5d"
    },
    "play": {
     "note": 94,
     "channel": "any",
     "source": "ardour: 0x5e"
    },
    "record": {
     "note": 95,
     "channel": "any",
     "source": "ardour: 0x5f"
    },
    "cycle": {
     "note": 86,
     "channel": "any",
     "source": "ardour: Cycle 0x56"
    }
   }
  }
 ],
 "feedback": {
  "requires": "none",
  "leds": {
   "controls": [
    "stop",
    "play",
    "record",
    "cycle"
   ],
   "on": 127,
   "off": 0,
   "source": "ardour: a button's LED is a note on with velocity 127 (on), 1 (flashing) or 0 (off)"
  }
 },
