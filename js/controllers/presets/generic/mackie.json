 "id": "generic/mackie",
 "name": "Mackie Control",
 "maker": "Generic",
 "models": [
  "Controllers in Mackie Control (MCU) mode"
 ],
 "status": "community",
 "verified": "documented",
 "generic": true,
 "description": "A controller in its Mackie Control mode: V-Pots move the page, faders 1-4 the volume, oscillator 2, sub and noise (5-8 the loop slots), the master fader the volume, the jog wheel browses (Select 1 confirms), Select 2-8 run loop slots, the metronome, tap and record, and the transport plays, stops, records and loops. Transport LEDs light (a note echoed back). Its messages come from Ardour's implementation of the protocol.",
 "sources": [
  {
   "id": "ardour",
   "title": "Ardour's Mackie Control surface (libs/surfaces/mackie: device_info.cc, surface.cc, pot.cc, jog.cc)",
   "url": "https://github.com/Ardour/ardour/tree/master/libs/surfaces/mackie",
   "notes": "An open-source DAW's implementation of the protocol, not Mackie's own document."
  }
 ],
