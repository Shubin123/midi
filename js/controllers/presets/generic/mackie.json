    },
    "jog": {
     "do": "browse"
    },
    "select1": {
     "do": "confirm"
    },
    "select2": {
     "do": "loop",
     "slot": 1,
     "hold": {
      "do": "clear",
      "slot": 1
     }
    },
    "select3": {
     "do": "loop",
     "slot": 2,
     "hold": {
      "do": "clear",
